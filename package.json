{
  "name": "doblonia",
  "private": true,
  "version": "0.1.0",
  "description": "Doblonia.io — sucesor espiritual de código abierto de un juego naval de navegador de 2016. Sin afiliacion con los creadores originales.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@doblonia/server",
    "dev:client": "npm run dev --workspace=@doblonia/client",
    "build": "npm run build --workspace=@doblonia/client && node scripts/build-server.mjs",
    "typecheck": "tsc -p packages/content --noEmit && tsc -p packages/sim --noEmit && tsc -p packages/protocol --noEmit && tsc -p apps/server --noEmit && tsc -p apps/client --noEmit && tsc -p tsconfig.tools.json",
    "test": "node scripts/test.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint apps packages scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "ai:report": "tsx scripts/ai-report.ts",
    "test:soak": "tsx scripts/soak.ts",
    "test:network": "tsx apps/client/bench/resilience.ts",
    "test:load": "node scripts/load-rooms.mjs",
    "test:smoke": "tsx apps/client/bench/smoke.ts",
    "package:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
