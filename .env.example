# npm start loads this file when copied to .env. Never commit secrets.
# npm start always sets NODE_ENV=production.
PORT=2567
HOST=0.0.0.0
# Comma-separated origins when the frontend is hosted on another domain.
ALLOWED_ORIGINS=
# Build-time only: leave empty when the website and game share an origin.
VITE_SERVER_URL=
# Set this to the public repository before publishing a build.
VITE_SOURCE_URL=https://github.com/Choco-Studio/doblonia
